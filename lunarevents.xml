<?xml version="1.0" encoding="utf-8"?>
<!-- Lunar Events 0.4.0 — необязательные настройки.
     Файл лежит в корне мода, а не в Config/, чтобы игра не пыталась
     обработать его как XPath-патч. Если файла нет — значения по умолчанию. -->
<LunarEvents>
  <!-- Дневные фазы 04:00–22:00.
       enabled    — вкл/выкл модуль;
       rareChance — шанс редкой «двойной» фазы в процентах (0–100). -->
  <Day enabled="true" rareChance="12" />

  <!-- Диагностика в лог: строка раз в 10 секунд (день, фаза, часы, живые
       «дикие» зомби). Нужна только при отладке — по умолчанию выключена,
       иначе лог растёт на ~1200 строк в час. -->
  <Log diag="false" />

  <!-- Админ-панель: только хост, чей id или имя есть в списке.
       key   — клавиша (NumPad7, NumPad9, F10, Ctrl+NumPad7...);
       ids   — Steam/EOS идентификаторы через запятую;
       names — имена игроков (запасной вариант, если id не пришёл).
       Пустые ids и names = панель у любого хоста (для отладки). -->
  <Admin enabled="true" key="NumPad7"
         ids="Steam_76561198287199664, 00024b296e1149fa8b2efebcf61a13f9"
         names="BlackMass" />
</LunarEvents>
