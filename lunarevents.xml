<?xml version="1.0" encoding="utf-8"?>
<!-- Lunar Events 0.3.0 — необязательные настройки.
     Файл лежит в корне мода, а не в Config/, чтобы игра не пыталась
     обработать его как XPath-патч. Если файла нет — значения по умолчанию. -->
<LunarEvents>
  <!-- Дневные фазы 04:00–22:00.
       enabled    — вкл/выкл модуль;
       rareChance — шанс редкой «двойной» фазы в процентах (0–100). -->
  <Day enabled="true" rareChance="12" />
</LunarEvents>
